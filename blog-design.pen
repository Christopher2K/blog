                          "name": "Second section heading",
                          "fill": "$console-ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Avec des si...",
                          "lineHeight": 1.25,
                          "fontFamily": "$font-source-body",
                          "fontSize": 30,
                          "fontWeight": "bold"
                        },
                        {
                          "type": "text",
                          "id": "f7SSI",
                          "name": "Reflection introduction",
                          "fill": "$console-ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Maintenant, tu sais à peu près où j’en suis. Je vais lister en vrac deux ou trois trucs que j’aurais changés, ou faits d’une manière différente.",
                          "lineHeight": 1.8,
                          "fontFamily": "$font-source-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "UP5pC",
                          "name": "Article blockquote",
                          "width": "fill_container",
