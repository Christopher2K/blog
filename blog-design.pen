                              "fill": "$console-ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "« Avoir peur de l’échec et de la prise de risque. »",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-source-body",
                              "fontSize": 17,
                              "fontWeight": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
