---
import { getLocale, getTranslator } from "@/i18n";
import { getRssPath } from "@/utils/routes";
import { css } from "@/style/css";

export interface Props {
  currentFile: string;
}

const { currentFile } = Astro.props;
const locale = getLocale(Astro.locals.locale);
const t = getTranslator(locale);

const footerStyle = css({
  minHeight: "44px",
  display: "flex",
  alignItems: "center",
  justifyContent: "space-between",
  flexWrap: "wrap",
  gap: "2",
  py: "2",
  px: { base: "5", md: "8", lg: "4" },
  bg: "panel",
  borderTopWidth: "1px",
  borderColor: "ruleStrong",
  color: "dim",
  fontSize: { base: "8px", md: "10px" },
});

const groupStyle = css({
  display: "flex",
  alignItems: "center",
  flexWrap: "wrap",
  gap: "4",
});

const modeStyle = css({
  bg: "accent",
  color: "bg",
  px: "3",
  py: "1",
  fontWeight: "bold",
});

const linkStyle = css({
  display: "inline-flex",
  alignItems: "center",
  minHeight: "36px",
  color: "accent",
  _hover: { textDecoration: "underline", textUnderlineOffset: "3px" },
});
---

<footer class={footerStyle}>
  <div class={groupStyle}>
    <span class={modeStyle}>{t("common:footer.mode")}</span>
    <span>
      {currentFile}&nbsp;&nbsp; utf-8 · {locale} · LF
    </span>
  </div>
  <div class={groupStyle}>
    <span class={css({ display: { base: "none", md: "inline" } })}>
      {t("common:footer.credits")}
    </span>
    <span class={css({ display: { base: "inline", md: "none" } })}>
      {t("common:footer.shortCredits")}
    </span>
    <a href={getRssPath(locale)} class={linkStyle}>
      {t("common:footer.rss")}
    </a>
  </div>
</footer>
