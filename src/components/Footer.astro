---
import { RssIcon } from "lucide-solid";

import { t, l } from "@/i18n";
import { css } from "@/style/css";
import { vstack } from "@/style/patterns";

const footerStyle = css({
  width: "full",
  display: "flex",
  flexDirection: "column",
  alignItems: "center",
  justifyContent: "center",
  gap: "5",
  py: "10",
  px: "6",
  mx: "auto",
});

const footerHrStyle = css({
  width: "full",
  maxWidth: "contentWidth",
  borderWidth: "0",
  borderTopWidth: "1px",
  borderTopStyle: "solid",
  borderTopColor: "border",
  mb: "2",
});

const footerTextContainerStyle = vstack({
  w: "full",
  gap: "3",
  justifyContent: "center",
  alignItems: "center",
});

const footerTextStyle = css({
  textStyle: "small",
  color: "inkMuted",
  textAlign: "center",
});

const footerLinkStyle = css({
  display: "inline-flex",
  alignItems: "center",
  gap: "2",
  textStyle: "small",
  fontWeight: "bold",
  color: "accentHover",
  textDecoration: "underline",
  textUnderlineOffset: "4px",
  transition: "color 0.15s ease",
  _hover: {
    color: "ink",
  },
});
---

<footer class={footerStyle}>
  <hr class={footerHrStyle} />
  <div class={footerTextContainerStyle}>
    <p class={footerTextStyle}>{t("common:footer.credits")}</p>
    <a href={l("/rss.xml")} class={footerLinkStyle}>
      <RssIcon />
      {t("common:footer.rss")}
    </a>
  </div>
</footer>
