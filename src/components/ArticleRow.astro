---
import { ArrowUpRightIcon } from "lucide-solid";
import { format } from "@/utils/date";
import { css } from "@/style/css";

export interface Props {
  title: string;
  href: string;
  tags: string[];
  date: Date;
}
const { title, href, tags, date } = Astro.props;

const rowStyle = css({
  display: "flex",
  alignItems: "center",
  gap: "6",
  w: "full",
  px: "2",
  py: "5",
  borderBottom: "1px solid",
  borderColor: "border",
  transition: "background-color 0.15s ease",
  _hover: {
    bg: "surface",
    "& .article-title": {
      color: "accentHover",
    },
  },
});

const dateStyle = css({
  fontFamily: "body",
  fontSize: "xs",
  color: "inkMuted",
  w: "24",
  flexShrink: "0",
});

const titleStyle = css({
  textStyle: { base: "heading4", md: "heading3" },
  color: "ink",
  flex: "1",
  transition: "color 0.15s ease",
});

const tagsStyle = css({
  display: { base: "none", md: "block" },
  fontFamily: "body",
  fontSize: "11px",
  letterSpacing: "0.06em",
  textTransform: "uppercase",
  color: "inkMuted",
  flexShrink: "0",
});

const iconStyle = css({
  color: "accentHover",
  flexShrink: "0",
});
---

<li>
  <a href={href} class={rowStyle}>
    <span class={dateStyle}>{format(date, "yyyy-MM-dd")}</span>
    <span class={`article-title ${titleStyle}`}>{title}</span>
    {tags.length > 0 && (
      <span class={tagsStyle}>{tags.slice(0, 3).join(" · ")}</span>
    )}
    <ArrowUpRightIcon class={iconStyle} size={18} />
  </a>
</li>
