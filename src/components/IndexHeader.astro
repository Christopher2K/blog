---
import { getLocale, getTranslator } from "@/i18n";
import { css } from "@/style/css";

export interface Props {
  articleCount: number;
  projectCount: number;
}

const { articleCount, projectCount } = Astro.props;
const t = getTranslator(getLocale(Astro.locals.locale));
const currentYear = new Date().getFullYear();
const facts = [
  {
    value: String(currentYear - 2015).padStart(2, "0"),
    label: t("home:yearsDev"),
  },
  { value: String(articleCount).padStart(2, "0"), label: t("home:articles") },
  { value: String(projectCount).padStart(2, "0"), label: t("home:projects") },
];

const headerStyle = css({
  px: { base: "6", md: "8", lg: "14" },
  py: { base: "8", md: "10", lg: "14" },
  borderBottomWidth: "1px",
  borderColor: "rule",
});

const breadcrumbStyle = css({
  display: "flex",
  justifyContent: "space-between",
  gap: "4",
  color: "dim",
  textStyle: "label",
  fontSize: { base: "8px", md: "9px" },
  mb: { base: "8", lg: "10" },
});

const commandStyle = css({
  display: { base: "none", lg: "flex" },
  gap: "2",
  color: "dim",
  fontSize: "11px",
  mb: "8",
});

const titleStyle = css({
  textStyle: "heading1",
  color: "ink",
  maxWidth: "760px",
});

const bioStyle = css({
  mt: "6",
  maxWidth: "760px",
  color: "dim",
  fontSize: { base: "11px", md: "13px" },
  lineHeight: "1.9",
  whiteSpace: "pre-line",
});

const factsStyle = css({
  display: "grid",
  gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
  mt: { base: "8", lg: "10" },
  pt: "5",
  borderTopWidth: "1px",
  borderColor: "rule",
});

const factStyle = css({
  display: "flex",
  flexDirection: "column",
});

const factValueStyle = css({
  color: "accent",
  fontSize: { base: "22px", md: "24px" },
  lineHeight: "1",
  fontWeight: "bold",
  order: "0",
});

const factLabelStyle = css({
  mt: "2",
  color: "dim",
  textStyle: "label",
  fontSize: { base: "7px", md: "9px" },
  order: "1",
});
---

<header class={headerStyle} id="introduction">
  <div class={breadcrumbStyle}>
    <span>{t("home:breadcrumb")}</span>
    <span>{t("common:nav.location").toUpperCase()}</span>
  </div>
  <div class={commandStyle}>
    <span class={css({ color: "accent" })}>chris@toronto</span>
    <span>
      :~/{getLocale(Astro.locals.locale) === "fr" ? "accueil" : "home"}$
    </span>
    <span class={css({ color: "ink" })}>{t("home:readme")}</span>
  </div>
  <h1 class={titleStyle}>
    Christopher N.
    <br />
    Katoyi Kaba
  </h1>
  <p class={bioStyle}>{t("home:bio")}</p>
  <dl class={factsStyle}>
    {facts.map((fact) => (
      <div class={factStyle}>
        <dt class={factLabelStyle}>{fact.label}</dt>
        <dd class={factValueStyle}>{fact.value}</dd>
      </div>
    ))}
  </dl>
</header>
