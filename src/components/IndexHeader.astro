---
import { Image } from "astro:assets";

import { t } from "@/i18n";
import chrisImage from "@/assets/common/chris.jpg";
import Socials from "@/components/Socials.astro";
import { css } from "@/style/css";
import { vstack } from "@/style/patterns";

const headerStyle = css({
  w: "full",
  px: "6",
  mb: "20",
  display: "flex",
  flexDirection: "column",
  alignItems: "center",
  justifyContent: "center",
  gap: "10",
  md: {
    flexDirection: "row",
    gap: "12",
  },
});

const headerImageContainerStyle = css({
  w: "fit-content",
  h: "fit-content",
  flexShrink: "0",
  "& img": {
    display: "block",
    width: "auto",
    maxWidth: "260px",
    borderRadius: "card",
    border: "1px solid",
    borderColor: "border",
    boxShadow: "card",
  },
});

const headerTextContainerStyle = vstack({
  maxWidth: "560px",
  justifyContent: "center",
  alignItems: "center",
  textAlign: "center",
  gap: "4",
  md: {
    alignItems: "flex-start",
    textAlign: "left",
  },
});

const headerTitleStyle = css({
  textStyle: "heading1",
});

const headerSubtitleStyle = css({
  textStyle: "label",
  color: "accentHover",
});

const headerBodyStyle = css({
  textStyle: "body",
  color: "inkMuted",
});

const headerSocialsContainerStyle = css({
  mt: "2",
});
---

<header class={headerStyle}>
  <div class={headerImageContainerStyle}>
    <Image src={chrisImage} alt="Christopher's photo" />
  </div>
  <div class={headerTextContainerStyle}>
    <h1 class={headerTitleStyle}>👋 Christopher K.</h1>
    <p class={headerSubtitleStyle}>LLCoolChris_ 📺</p>

    <p class={headerBodyStyle}>{t("home:bio")}</p>
    <div class={headerSocialsContainerStyle}>
      <Socials />
    </div>
  </div>
</header>
