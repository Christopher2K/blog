---
import { Image } from "astro:assets";
import { SUPPORTED_LANG } from "@/i18n";

import { t, l } from "@/i18n";
import coolNerdIconImage from "@/assets/common/cool-nerd-icon.png";
import { css } from "@/style/css";
import { hstack } from "@/style/patterns";
import { youtube, twitch } from "@/utils/link";
import { RssIcon } from "lucide-solid";

const navStyle = css({
  display: "flex",
  flexDirection: "row",
  alignItems: "center",
  justifyContent: "space-between",
  gap: "4",
  flexWrap: "wrap",
  w: "100%",
  maxWidth: "contentWidth",
  mx: "auto",
  px: "6",
  py: "5",
});

const navHomeLinkStyle = css({
  display: "inline-flex",
  alignItems: "center",
  borderRadius: "pill",
});

const navRightStyle = hstack({
  gap: "4",
  flexWrap: "wrap",
  justifyContent: "flex-end",
});

const navUlStyle = hstack({
  gap: "1",
  flexWrap: "wrap",
});

const navLiStyle = css({
  display: "inline-flex",
  alignItems: "center",
  textStyle: "body",
  fontWeight: "bold",
  color: "inkMuted",
  px: "3",
  py: "2",
  borderRadius: "pill",
  transition: "background-color 0.15s ease, color 0.15s ease",
  _hover: {
    color: "ink",
    backgroundColor: "accentSoft",
  },
});

const navIconStyle = css({
  display: "inline-flex",
  alignItems: "center",
  justifyContent: "center",
  color: "inkMuted",
  px: "2.5",
  py: "2",
  borderRadius: "pill",
  transition: "background-color 0.15s ease, color 0.15s ease",
  _hover: {
    color: "ink",
    backgroundColor: "accentSoft",
  },
});

const navLangStyle = hstack({
  gap: "1",
});

const langLinkStyle = css({
  display: "inline-flex",
  alignItems: "center",
  px: "2",
  py: "1",
  borderRadius: "pill",
  transition: "background-color 0.15s ease",
  _hover: {
    backgroundColor: "accentSoft",
  },
});

const headerImage = css({
  width: "40px",
  height: "40px",
  borderRadius: "pill",
});

const path = Astro.url.pathname
  .split("/")
  .filter((chunk) => !(SUPPORTED_LANG as readonly string[]).includes(chunk))
  .join("/");

export interface Props {
  frUrl?: string;
  enUrl?: string;
}

const { frUrl = path, enUrl = `/en${path}` } = Astro.props;
---

<nav class={navStyle}>
  <a href={l("/")} class={navHomeLinkStyle} aria-label={t("common:nav.home")}>
    <Image class={headerImage} src={coolNerdIconImage} alt="Cool Nerd Icon" />
  </a>
  <div class={navRightStyle}>
    <ul class={navUlStyle}>
      <li>
        <a href={l("/")} class={navLiStyle}>
          {t("common:nav.home")}
        </a>
      </li>
      <li>
        <a href={twitch} class={navLiStyle}>
          {t("common:nav.twitch")}
        </a>
      </li>
      <li>
        <a href={youtube} class={navLiStyle}>
          {t("common:nav.videos")}
        </a>
      </li>
      <li>
        <a
          href={l("/rss.xml")}
          class={navIconStyle}
          aria-label={t("common:nav.rss")}
        >
          <RssIcon />
        </a>
      </li>
    </ul>
    <div class={navLangStyle}>
      <a class={langLinkStyle} title="Français" href={frUrl}>
        🇫🇷
      </a>
      <a class={langLinkStyle} title="English" href={enUrl}>
        🇬🇧
      </a>
    </div>
  </div>
</nav>
