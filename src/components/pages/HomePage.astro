---
import { getTranslator, type SupportedLang } from "@/i18n";
import Base from "@/layouts/Base.astro";
import ArticleRow from "@/components/ArticleRow.astro";
import ProjectRow from "@/components/ProjectRow.astro";
import IndexHeader from "@/components/IndexHeader.astro";
import IndexSectionList from "@/components/IndexSectionList.astro";
import ConsoleWorkspace from "@/components/ConsoleWorkspace.astro";
import HomeSidebar from "@/components/HomeSidebar.astro";
import { getBlogCollection } from "@/article";
import { getProjectsCollection } from "@/projects";
import { getBlogPath, getHomePath, getProjectsPath } from "@/utils/routes";
import { twitch } from "@/utils/link";
import { ArrowUpRightIcon } from "lucide-solid";
import { css } from "@/style/css";

export interface Props {
  locale: SupportedLang;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
const [blogCollection, projectsCollection] = await Promise.all([
  getBlogCollection(locale),
  getProjectsCollection(locale),
]);

const liveStyle = css({
  display: "flex",
  alignItems: "center",
  justifyContent: "space-between",
  flexWrap: "wrap",
  gap: "6",
  px: { base: "6", md: "8", lg: "14" },
  py: { base: "8", md: "10" },
  bg: "panel",
});
const liveLabelStyle = css({
  display: "flex",
  alignItems: "center",
  gap: "3",
  color: "ink",
  textStyle: "label",
  fontSize: "10px",
});
const liveDotStyle = css({
  width: "8px",
  height: "8px",
  bg: "live",
  borderRadius: "md",
});
const liveLinkStyle = css({
  display: "inline-flex",
  alignItems: "center",
  justifyContent: "center",
  gap: "2",
  minHeight: "44px",
  px: "5",
  bg: "accent",
  color: "bg",
  textStyle: "label",
  fontSize: "9px",
  _hover: { textDecoration: "underline", textUnderlineOffset: "3px" },
});
---

<Base
  title={t("home:title")}
  forceUseDefaultOgTitle
  canonicalPath={getHomePath(locale)}
  alternatePaths={{ fr: getHomePath("fr"), en: getHomePath("en") }}
  section="home"
  currentFile={locale === "fr" ? "~/accueil" : "~/home"}
  frUrl={getHomePath("fr")}
  enUrl={getHomePath("en")}
>
  <ConsoleWorkspace>
    <HomeSidebar
      slot="sidebar"
      articleCount={blogCollection.length}
      projectCount={projectsCollection.length}
    />
    <IndexHeader
      articleCount={blogCollection.length}
      projectCount={projectsCollection.length}
    />
    <IndexSectionList
      kind="articles"
      title={t("home:blogSectionTitle")}
      count={blogCollection.length}
      href={getBlogPath(locale)}
      linkLabel={t("home:allArticles")}
    >
      {blogCollection.map((entry, index) => (
        <ArticleRow
          title={entry.data.title}
          date={entry.data.publishingDate}
          tags={entry.data.tags}
          href={entry.path}
          index={index + 1}
          latest={index === 0}
        />
      ))}
    </IndexSectionList>
    <IndexSectionList
      kind="projects"
      title={t("home:projectsSectionTitle")}
      count={projectsCollection.length}
      href={getProjectsPath(locale)}
      linkLabel={t("home:allProjects")}
    >
      {projectsCollection.map((entry) => (
        <ProjectRow
          title={entry.data.name}
          tech={entry.data.tech}
          date={entry.data.publishingDate}
          href={entry.data.url}
          description={entry.data.description}
          thumbnail={entry.data.thumbnail}
          type={entry.data.type}
        />
      ))}
    </IndexSectionList>
    <section class={liveStyle} aria-label={t("home:liveLabel")}>
      <div>
        <p class={liveLabelStyle}>
          <span class={liveDotStyle} aria-hidden="true"></span>
          {t("home:liveLabel")}
        </p>
        <p class={css({ color: "dim", fontSize: "10px", mt: "3" })}>
          twitch.tv/llcoolchris_
        </p>
      </div>
      <a
        href={twitch}
        target="_blank"
        rel="noopener noreferrer"
        class={liveLinkStyle}
      >
        <span class={css({ display: { base: "none", md: "inline" } })}>
          {t("home:joinStream")}
        </span>
        <span class={css({ display: { base: "inline", md: "none" } })}>
          {t("home:join")}
        </span>
        <ArrowUpRightIcon size={15} aria-hidden="true" />
      </a>
    </section>
  </ConsoleWorkspace>
</Base>
