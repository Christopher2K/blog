---
import { css } from "@/style/css";

const workspaceStyle = css({
  display: "grid",
  gridTemplateColumns: {
    base: "minmax(0, 1fr)",
    lg: "282px minmax(0, 1fr)",
  },
  gridTemplateRows: "minmax(0, 1fr)",
  minWidth: "0",
  height: "100%",
});

const sidebarStyle = css({
  display: { base: "none", lg: "block" },
  minWidth: "0",
  minHeight: "0",
  overflowY: "auto",
  bg: "panel",
  borderRightWidth: { base: "0", lg: "1px" },
  borderColor: "ruleStrong",
});

const mainStyle = css({
  minWidth: "0",
  minHeight: "0",
  height: "100%",
  overflowX: "hidden",
  overflowY: "auto",
});
---

<div class={workspaceStyle}>
  <aside class={sidebarStyle}>
    <slot name="sidebar" />
  </aside>
  <div class={mainStyle}>
    <slot />
  </div>
</div>
