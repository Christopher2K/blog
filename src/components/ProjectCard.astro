---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import { t } from "@/i18n";
import { css } from "@/style/css";
import { vstack } from "@/style/patterns";

const rootStyle = css({
  w: "full",
  h: "100%",
  display: "flex",
  flexDirection: "column",
  overflow: "hidden",
  bg: "surface",
  border: "1px solid",
  borderColor: "border",
  borderRadius: "card",
  boxShadow: "card",
  transition:
    "transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease",
  _hover: {
    transform: "translateY(-2px)",
    borderColor: "borderStrong",
    boxShadow: "cardHover",
  },
});

const headerStyle = css({
  width: "100%",
});

const imageStyle = css({
  width: "100%",
  height: "auto",
  aspectRatio: "16 / 9",
  objectFit: "cover",
});

const textContainerStyle = vstack({
  width: "100%",
  justifyContent: "flex-start",
  alignItems: "flex-start",
  gap: "3",
  p: "6",
  pb: "4",
});

const titleStyle = css({
  textStyle: "heading4",
  color: "ink",
});

const descriptionStyle = css({
  textStyle: "body",
  color: "inkMuted",
});

const footerStyle = vstack({
  width: "100%",
  flexGrow: "1",
  justifyContent: "flex-end",
  alignItems: "flex-start",
  px: "6",
  pb: "6",
});

const footerLinkStyle = css({
  display: "inline-flex",
  alignItems: "center",
  textStyle: "body",
  fontWeight: "bold",
  backgroundColor: "accent",
  borderRadius: "pill",
  color: "onAccent",
  textAlign: "center",
  px: "5",
  py: "2",
  transition: "background-color 0.15s ease",
  _hover: {
    backgroundColor: "accentHover",
  },
});

export interface Props {
  title: string;
  description: string;
  href: string;
  imagePath: string;
}

const { title, description, href, imagePath } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/projects/*.{jpeg,jpg,png,gif}",
);
const expandedPath = "../assets" + imagePath;
---

<article class={rootStyle}>
  <header class={headerStyle}>
    <Image class={imageStyle} src={images[expandedPath]()} alt="" />
  </header>

  <div class={textContainerStyle}>
    <h3 class={titleStyle}>{title}</h3>
    <p class={descriptionStyle}>{description}</p>
  </div>

  <footer class={footerStyle}>
    <a class={footerLinkStyle} href={href}>
      {t("common:projects.ctaLabel")}
    </a>
  </footer>
</article>
