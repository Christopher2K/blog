---
import Tag from "@/components/Tag.astro";
import { format } from "@/utils/date";
import { css } from "@/style/css";
import { hstack, vstack } from "@/style/patterns";

export interface Props {
  title: string;
  href: string;
  description: string;
  tags: string[];
  date: Date;
}
const { title, href, description, tags, date } = Astro.props;

const articleContainerStyle = css({
  w: "full",
  h: "100%",
  p: "6",
  bg: "surface",
  border: "1px solid",
  borderColor: "border",
  borderRadius: "card",
  boxShadow: "card",
  transition:
    "transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease",
  _hover: {
    transform: "translateY(-2px)",
    borderColor: "borderStrong",
    boxShadow: "cardHover",
  },
});

const linkStyle = vstack({
  w: "full",
  h: "100%",
  justifyContent: "flex-start",
  alignItems: "flex-start",
  gap: "3",
});

const dateStyle = css({
  textStyle: "label",
  color: "accentHover",
});

const titleStyle = css({
  textStyle: "heading4",
  color: "ink",
});

const descriptionStyle = css({
  textStyle: "body",
  color: "inkMuted",
});

const tagListStyle = hstack({
  flexWrap: "wrap",
  gap: "2",
  mt: "auto",
  pt: "3",
});
---

<article class={articleContainerStyle}>
  <a href={href} class={linkStyle}>
    <span class={dateStyle}>{format(date)}</span>
    <h3 class={titleStyle}>{title}</h3>
    <p class={descriptionStyle}>{description}</p>
    <ul class={tagListStyle}>
      {tags.map((tag) => (
        <li>
          <Tag name={tag} />
        </li>
      ))}
    </ul>
  </a>
</article>
