---
import { css } from "@/style/css";

export interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span
  class={css({
    display: "inline-flex",
    alignItems: "center",
    fontFamily: "body",
    fontSize: "12px",
    lineHeight: "1",
    px: "3",
    py: "1.5",
    fontWeight: "bold",
    bg: "accentSoft",
    color: "tagText",
    borderRadius: "pill",
  })}
>
  {name}
</span>
