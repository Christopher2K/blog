---
import { getTranslator, getLocale } from "@/i18n";
import { css } from "@/style/css";

export interface Props {
  title: string;
  count: number;
  href: string;
  linkLabel: string;
  kind: "articles" | "projects";
}

const { title, count, href, linkLabel, kind } = Astro.props;
const t = getTranslator(getLocale(Astro.locals.locale));

const sectionStyle = css({
  px: { base: "6", md: "8", lg: "14" },
  py: { base: "8", md: "10", lg: "12" },
  borderBottomWidth: "1px",
  borderColor: "rule",
});

const headingRowStyle = css({
  display: "flex",
  alignItems: "flex-end",
  justifyContent: "space-between",
  flexWrap: "wrap",
  gap: "4",
  pb: "4",
  borderBottomWidth: "1px",
  borderColor: "ruleStrong",
});

const titleGroupStyle = css({
  display: "flex",
  alignItems: "baseline",
  gap: "3",
});
const headingStyle = css({
  fontSize: { base: "24px", md: "20px" },
  fontWeight: "bold",
  color: "ink",
});
const summaryStyle = css({
  textStyle: "label",
  color: "dim",
  fontSize: { base: "8px", md: "9px" },
});
const allLinkStyle = css({
  color: "accent",
  fontSize: "10px",
  minHeight: "44px",
  display: "inline-flex",
  alignItems: "center",
  _hover: { textDecoration: "underline", textUnderlineOffset: "3px" },
});
const columnsStyle = css({
  display: { base: "none", lg: "grid" },
  gridTemplateColumns: "104px minmax(0, 1fr) 180px 20px",
  gap: "5",
  px: "5",
  py: "3",
  color: "dim",
  textStyle: "label",
  fontSize: "8px",
  borderBottomWidth: "1px",
  borderColor: "ruleSubtle",
});
---

<section class={sectionStyle} aria-labelledby={`${kind}-heading`}>
  <div class={headingRowStyle}>
    <div>
      <div class={titleGroupStyle}>
        <span class={css({ color: "accent" })} aria-hidden="true">
          $
        </span>
        <h2 id={`${kind}-heading`} class={headingStyle}>
          {title}
        </h2>
      </div>
      <p class={summaryStyle}>
        {count}{" "}
        {kind === "articles" ? t("home:articlesUnit") : t("home:projectsUnit")}{" "}
        — {t("home:mostRecent")}
      </p>
    </div>
    <a href={href} class={allLinkStyle}>
      {linkLabel} ↗
    </a>
  </div>
  {kind === "articles" && (
    <div class={columnsStyle} aria-hidden="true">
      <span>{t("home:date")}</span>
      <span>{t("home:titleColumn")}</span>
      <span>{t("home:tags")}</span>
      <span></span>
    </div>
  )}
  <ul>
    <slot />
  </ul>
</section>
