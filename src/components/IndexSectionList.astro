---
import { css } from "@/style/css";
import { hstack, vstack } from "@/style/patterns";

export interface Props {
  title: string;
  count: number;
}

const { title, count } = Astro.props;

const sectionContainerStyle = vstack({
  w: "full",
  justifyContent: "flex-start",
  alignItems: "flex-start",
  marginBottom: "20",
  px: "6",
});

const sectionHeaderStyle = hstack({
  w: "full",
  justifyContent: "space-between",
  alignItems: "flex-end",
  px: "2",
  pb: "4",
  borderBottom: "1px solid",
  borderColor: "borderStrong",
});

const sectionTitleStyle = css({
  textStyle: "heading2",
  color: "ink",
});

const sectionCountStyle = css({
  textStyle: "label",
  color: "inkMuted",
});

const sectionItemsContainerStyle = vstack({
  w: "full",
  gap: "0",
  alignItems: "stretch",
});
---

<section class={sectionContainerStyle}>
  <div class={sectionHeaderStyle}>
    <h2 class={sectionTitleStyle}>{title}</h2>
    <span class={sectionCountStyle}>{String(count).padStart(2, "0")}</span>
  </div>

  <ul class={sectionItemsContainerStyle}>
    <slot />
  </ul>
</section>
