---
import "@/index.css";
import { getLocale, getTranslator, type SupportedLang } from "@/i18n";
import SEO from "@/components/SEO.astro";
import Footer from "@/components/Footer.astro";
import { getRssPath } from "@/utils/routes";
import { css } from "@/style/css";

const mainStyle = css({
  pt: "0",
  pb: "10",
  width: "100%",
  maxWidth: "contentWidth",
  mx: "auto",
});

export interface Props {
  title: string;
  description?: string;
  forceUseDefaultOgTitle?: boolean;
  ogType?: "website" | "article";
  canonicalPath?: string;
  alternatePaths?: Partial<Record<SupportedLang, string>>;
  includeXDefault?: boolean;
}

const {
  title,
  description,
  forceUseDefaultOgTitle,
  ogType,
  canonicalPath,
  alternatePaths,
  includeXDefault,
} = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getTranslator(locale);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="stylesheet" href="/app.css" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/IBMPlexMono-Regular.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/IBMPlexMono-Bold.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/IBMPlexSansCond-Regular.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/IBMPlexSansCond-Bold.woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t("rss:title")}
      href={new URL(getRssPath(locale), Astro.site ?? Astro.url)}
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      {title}
      {description}
      {forceUseDefaultOgTitle}
      {ogType}
      {canonicalPath}
      {alternatePaths}
      {includeXDefault}
    />
    <!-- Privacy-friendly analytics by Plausible -->
    <script
      async
      src="https://stats.coolsrv.dev/js/pa-htYElZWwGlKeVeDMEd_IX.js"
    ></script>
    <script is:inline>
      ((window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        }),
        (plausible.init =
          plausible.init ||
          function (i) {
            plausible.o = i || {};
          }));
      plausible.init();
    </script>
  </head>

  <body>
    <main class={mainStyle}>
      <slot />
      <Footer />
    </main>
  </body>
</html>
