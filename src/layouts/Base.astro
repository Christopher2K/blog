---
import "@/index.css";
import { getLocale, getTranslator, type SupportedLang } from "@/i18n";
import SEO from "@/components/SEO.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import { getBlogCollection } from "@/article";
import { getProjectsCollection } from "@/projects";
import { getRssPath } from "@/utils/routes";
import { css } from "@/style/css";

export type ConsoleSection = "home" | "blog" | "projects";

export interface Props {
  title: string;
  description?: string;
  forceUseDefaultOgTitle?: boolean;
  ogType?: "website" | "article";
  canonicalPath?: string;
  alternatePaths?: Partial<Record<SupportedLang, string>>;
  section: ConsoleSection;
  currentFile: string;
  frUrl: string;
  enUrl: string;
}

const {
  title,
  description,
  forceUseDefaultOgTitle,
  ogType,
  canonicalPath,
  alternatePaths,
  section,
  currentFile,
  frUrl,
  enUrl,
} = Astro.props;
const locale = getLocale(Astro.locals.locale);
const t = getTranslator(locale);
const [articles, projects] = await Promise.all([
  getBlogCollection(locale),
  getProjectsCollection(locale),
]);

const shellStyle = css({
  display: "flex",
  flexDirection: "column",
  width: "100%",
  maxWidth: "contentWidth",
  height: "100dvh",
  mx: "auto",
  overflow: "hidden",
  bg: "bg",
  borderLeftWidth: "1px",
  borderRightWidth: "1px",
  borderColor: "ruleStrong",
});

const contentStyle = css({
  flex: "1",
  minHeight: "0",
  overflow: "hidden",
});

const skipLinkStyle = css({
  position: "fixed",
  top: "2",
  left: "2",
  zIndex: "50",
  px: "4",
  py: "3",
  bg: "accent",
  color: "bg",
  transform: "translateY(-200%)",
  _focus: { transform: "translateY(0)" },
});
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/IBMPlexMono-Regular.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/IBMPlexMono-Bold.woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t("rss:title")}
      href={new URL(getRssPath(locale), Astro.site ?? Astro.url)}
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      {title}
      {description}
      {forceUseDefaultOgTitle}
      {ogType}
      {canonicalPath}
      {alternatePaths}
    />
    <script
      async
      src="https://stats.coolsrv.dev/js/pa-htYElZWwGlKeVeDMEd_IX.js"
    ></script>
    <script is:inline>
      ((window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        }),
        (plausible.init =
          plausible.init ||
          function (i) {
            plausible.o = i || {};
          }));
      plausible.init();
    </script>
  </head>
  <body>
    <a href="#content" class={skipLinkStyle}>
      {t("common:skipToContent")}
    </a>
    <div class={shellStyle}>
      <Navbar
        {section}
        {frUrl}
        {enUrl}
        articleCount={articles.length}
        projectCount={projects.length}
      />
      <main id="content" class={contentStyle}>
        <slot />
      </main>
      <Footer {currentFile} />
    </div>
  </body>
</html>
