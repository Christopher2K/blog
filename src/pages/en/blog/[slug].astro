---
import ArticlePage, {
  type Props as ArticlePageProps,
} from "@/components/pages/ArticlePage.astro";
import { getArticleStaticPaths } from "@/article";

export function getStaticPaths() {
  return getArticleStaticPaths("en");
}

const { entry, lang } = Astro.props as ArticlePageProps;
---

<ArticlePage entry={entry} lang={lang} />
