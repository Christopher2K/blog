---
import ArticlePage from "@/components/pages/ArticlePage.astro";
import { resolveArticle } from "@/article";

const slug = Astro.params.slug;
const resolution = slug
  ? await resolveArticle(slug, Astro.locals.locale)
  : { type: "notFound" as const };

if (resolution.type === "redirect") {
  return Astro.redirect(resolution.path, 307);
}

if (resolution.type === "notFound") {
  return new Response("Article not found", { status: 404 });
}

const { entry } = resolution;
Astro.locals.locale = entry.locale;
---

<ArticlePage entry={entry} lang={entry.locale} />
